# The installer asks for this privately. Never commit a real token.
DISCORD_TOKEN=
FIER_CLIENT_ID=

# Required: the ONLY Discord server (guild) ID this bot may stay in.
# The installer asks for it right after the bot token. The bot leaves any other server.
FIER_ALLOWED_GUILD_ID=
# Optional: comma-separated Discord user IDs with full management access.
FIER_ADMIN_IDS=
# VPS creation is admin-only: server administrators plus FIER_ADMIN_IDS.
# Everyone can still manage/delete their OWN VPS.

FIER_DATA_DIR=/var/lib/fier/data
# Per-OS runtime images built by install.sh.
FIER_IMAGE_UBUNTU=fier-vps:local
FIER_IMAGE_DEBIAN=fier-vps:debian-12
# Legacy single-image installs: FIER_IMAGE is still accepted as the Ubuntu image
# when FIER_IMAGE_UBUNTU is unset.
FIER_NETWORK=fier-vps
FIER_VOLUME_HELPER=/usr/local/libexec/fier-volume

# Command arguments are whole numbers: RAM GiB, CPU cores, disk GiB.
FIER_MAX_RAM_GB=4
FIER_MAX_CPU=4
FIER_MAX_DISK_GB=20
FIER_MAX_VPS_PER_USER=2
FIER_MAX_VPS_TOTAL=20
# 0 = automatically budget 75% of host RAM / all logical host CPUs.
FIER_HOST_RAM_MB=0
FIER_HOST_CPU=0
