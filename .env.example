# The installer asks for this privately. Never commit a real token.
DISCORD_TOKEN=
NOIR_CLIENT_ID=

# Required: the ONLY Discord server (guild) ID this bot may stay in.
# The installer asks for it right after the bot token. The bot leaves any other server.
NOIR_ALLOWED_GUILD_ID=
# Optional: comma-separated Discord user IDs with full management access.
NOIR_ADMIN_IDS=
# VPS creation is admin-only: server administrators plus NOIR_ADMIN_IDS.
# Everyone can still manage/delete their OWN VPS.

NOIR_DATA_DIR=/var/lib/noir/data
# Per-OS runtime images built by install.sh.
NOIR_IMAGE_UBUNTU=noir-vps:local
NOIR_IMAGE_DEBIAN=noir-vps:debian-12
# Legacy single-image installs: NOIR_IMAGE is still accepted as the Ubuntu image
# when NOIR_IMAGE_UBUNTU is unset.
NOIR_NETWORK=noir-vps
NOIR_VOLUME_HELPER=/usr/local/libexec/noir-volume

# Command arguments are whole numbers: RAM GiB, CPU cores, disk GiB.
NOIR_MAX_RAM_GB=4
NOIR_MAX_CPU=4
NOIR_MAX_DISK_GB=20
NOIR_MAX_VPS_PER_USER=2
NOIR_MAX_VPS_TOTAL=20
# 0 = automatically budget 75% of host RAM / all logical host CPUs.
NOIR_HOST_RAM_MB=0
NOIR_HOST_CPU=0
