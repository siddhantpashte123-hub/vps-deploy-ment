# The installer asks for this privately. Never commit a real token.
DISCORD_TOKEN=
FIER_CLIENT_ID=

# Optional: restrict the bot to one Discord server.
FIER_ALLOWED_GUILD_ID=
# Optional: comma-separated Discord user IDs with full management access.
FIER_ADMIN_IDS=
# Optional: a role ID allowed to deploy. Without it, only server administrators
# and FIER_ADMIN_IDS can deploy. Everyone can still manage/delete their OWN VPS.
FIER_DEPLOY_ROLE_ID=

FIER_DATA_DIR=/var/lib/fier/data
FIER_IMAGE=fier-vps:local
FIER_NETWORK=fier-vps
FIER_VOLUME_HELPER=/usr/local/libexec/fier-volume

# Command arguments are whole numbers: RAM GiB, CPU cores, disk GiB.
FIER_MAX_RAM_GB=4
FIER_MAX_CPU=4
FIER_MAX_DISK_GB=20
FIER_MAX_VPS_PER_USER=2
FIER_MAX_VPS_TOTAL=20
# 0 = automatically budget 75% of host RAM / all logical host CPUs.
FIER_HOST_RAM_MB=0
FIER_HOST_CPU=0
