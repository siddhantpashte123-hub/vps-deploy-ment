[Unit]
Description=NOIR Discord VPS Manager
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=noir
Group=noir
SupplementaryGroups=docker
WorkingDirectory=/opt/noir
EnvironmentFile=/etc/noir/noir.env
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/noir/.venv/bin/python -m noir run
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
# The narrow root-owned sudo helper must create host-visible loop mounts and
# access the Docker socket. Namespace/capability sandboxing here would break
# those host operations. Docker-group access is already host-root-equivalent.
NoNewPrivileges=false
PrivateTmp=false
ProtectSystem=false
ProtectHome=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=noir

[Install]
WantedBy=multi-user.target
