#!/usr/bin/python3
"""Start OpenSSH sshd + a Pinggy TCP/HTTP tunnel inside the VPS container."""
import fcntl
import os
import pty
import re
import secrets
import select
import signal
import socket
import string
import subprocess
import sys
import time

DIR = "/tmp/noir-pinggy"
PID_FILE = DIR + "/pinggy.pid"
OUT_FILE = DIR + "/pinggy.out"
PASS_FILE = DIR + "/root.pass"
KEY_FILE = DIR + "/tunnel_key"
HTTP_PID_PREFIX = DIR + "/http-"
HTTP_OUT_PREFIX = DIR + "/http-"

VALID_ID = re.compile(r"(?:noir|fier)-[a-f0-9]{12}\Z")
TCP_URL_RE = re.compile(
    r"tcp://([A-Za-z0-9.-]+\.(?:pinggy\.link|pinggy\.online|pinggy\.io)):([0-9]{2,5})"
)
HTTPS_URL_RE = re.compile(
    r"https://[A-Za-z0-9.-]+\.(?:pinggy\.link|pinggy\.online|pinggy\.io)"
)
ANSI_RE = re.compile(r"\x1b(?:\[[0-9;?]*[A-Za-z]|\][^\x07]*\x07|[()][A-Za-z0-9])")


def _alive(pid: int) -> bool:
    if pid <= 1:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as handle:
            stat_txt = handle.read()
        # Reject zombie processes ("... ) Z ...")
        rparen = stat_txt.rfind(")")
        if rparen != -1 and stat_txt[rparen + 2 : rparen + 3] == "Z":
            return False
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            cmd = handle.read(4096)
        return b"noir-pinggy" in cmd or b"python" in cmd or b"ssh" in cmd
    except OSError:
        return False


def _read_int(path: str) -> int:
    try:
        with open(path) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return 0


def _port_listening(port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.5):
            return True
    except OSError:
        return False


def _ensure_tunnel_key() -> str:
    """Generate a passphrase-less client SSH key so Pinggy never blocks on password auth."""
    if not os.path.exists(KEY_FILE):
        subprocess.run(
            ["ssh-keygen", "-t", "ed25519", "-N", "", "-f", KEY_FILE, "-q"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    return KEY_FILE


def _ensure_openssh_server() -> None:
    """Auto-install openssh-server on older pre-upgrade containers if missing."""
    if os.path.exists("/usr/sbin/sshd"):
        return
    if os.path.exists("/usr/bin/apt-get"):
        env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}
        subprocess.run(
            ["apt-get", "update", "-qq"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=90,
            check=False,
        )
        subprocess.run(
            ["apt-get", "install", "-y", "-qq", "--no-install-recommends", "openssh-server"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=120,
            check=False,
        )
    elif os.path.exists("/sbin/apk"):
        subprocess.run(
            ["apk", "add", "--no-cache", "-q", "openssh-server", "shadow"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=90,
            check=False,
        )


def _unlock_root_account() -> None:
    """Alpine locks root (`root:!`) by default, which rejects SSH password login."""
    subprocess.run(
        ["passwd", "-u", "root"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def _ensure_sshd() -> str:
    _ensure_openssh_server()
    if not os.path.exists("/usr/sbin/sshd"):
        sys.stderr.write("openssh-server is missing inside the container.\n")
        raise SystemExit(3)

    os.makedirs("/run/sshd", mode=0o755, exist_ok=True)
    os.makedirs("/var/run/sshd", mode=0o755, exist_ok=True)
    os.makedirs("/etc/ssh/sshd_config.d", mode=0o755, exist_ok=True)
    subprocess.run(
        ["ssh-keygen", "-A"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )

    cfg_line = (
        "PermitRootLogin yes\n"
        "PasswordAuthentication yes\n"
        "KbdInteractiveAuthentication yes\n"
        "PubkeyAuthentication yes\n"
        "Subsystem sftp internal-sftp\n"
    )
    # Put override in sshd_config.d/00-noir.conf (Ubuntu/Debian Include it at top, first-match wins)
    dropin = "/etc/ssh/sshd_config.d/00-noir.conf"
    try:
        with open(dropin, "w") as handle:
            handle.write(cfg_line)
    except OSError:
        pass

    main_cfg = "/etc/ssh/sshd_config"
    marker = "# NOIR_ROOT_SSH"
    try:
        existing = open(main_cfg).read() if os.path.exists(main_cfg) else ""
    except OSError:
        existing = ""
    if marker not in existing:
        # Comment out conflicting UsePAM yes in containers lacking PAM limits
        patched = re.sub(r"(?m)^\s*UsePAM\s+yes\b", "UsePAM no", existing)
        with open(main_cfg, "w") as handle:
            handle.write(f"{patched}\n{marker}\nUsePAM no\n{cfg_line}")

    password = ""
    if os.path.exists(PASS_FILE):
        try:
            password = open(PASS_FILE).read().strip()
        except OSError:
            password = ""
    if not password:
        alphabet = string.ascii_letters + string.digits
        password = "".join(secrets.choice(alphabet) for _ in range(14))
        with open(PASS_FILE, "w", opener=lambda p, f: os.open(p, f, 0o600)) as handle:
            handle.write(password)
    chpasswd = subprocess.Popen(
        ["chpasswd"],
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    chpasswd.communicate(f"root:{password}\n".encode())
    _unlock_root_account()

    if not _port_listening(22):
        devnull = os.open(os.devnull, os.O_RDWR)
        subprocess.Popen(
            ["/usr/sbin/sshd"],
            stdin=devnull,
            stdout=devnull,
            stderr=devnull,
            close_fds=True,
            start_new_session=True,
        )
        os.close(devnull)
        for _ in range(25):
            if _port_listening(22):
                break
            time.sleep(0.2)
    if not _port_listening(22):
        sys.stderr.write("sshd did not start listening on port 22.\n")
        raise SystemExit(4)
    return password


def _spawn_pinggy_pty(remote_spec: str, target_dest: str, out_path: str, pid_path: str) -> None:
    key_path = _ensure_tunnel_key()
    for p in (out_path, pid_path):
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass
    # Double-fork daemon + close inherited Docker exec pipes so `docker exec` returns immediately
    pid = os.fork()
    if pid > 0:
        os.waitpid(pid, 0)
        return
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        with open(pid_path, "w", opener=lambda p, f: os.open(p, f, 0o600)) as handle:
            handle.write(str(pid2))
        os._exit(0)

    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        try:
            os.dup2(devnull, fd)
        except OSError:
            pass
    if devnull > 2:
        os.close(devnull)

    master_fd, slave_fd = pty.openpty()
    ssh_bin = "/usr/bin/ssh" if os.path.exists("/usr/bin/ssh") else "ssh"
    cmd = [
        ssh_bin,
        "-p",
        "443",
        "-t",
        "-i",
        key_path,
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "ServerAliveInterval=30",
        "-o",
        "ServerAliveCountMax=3",
        "-o",
        "ConnectTimeout=15",
        "-o",
        "ExitOnForwardFailure=yes",
        "-o",
        "LogLevel=ERROR",
        remote_spec,
        target_dest,
    ]
    proc = subprocess.Popen(
        cmd,
        stdin=slave_fd,
        stdout=slave_fd,
        stderr=slave_fd,
        close_fds=True,
        start_new_session=True,
        env={**os.environ, "HOME": "/home/noir", "TERM": "xterm"},
    )
    os.close(slave_fd)
    answered_pw = False
    with open(out_path, "wb", opener=lambda p, f: os.open(p, f, 0o600)) as sink:
        try:
            while proc.poll() is None:
                rlist, _, _ = select.select([master_fd], [], [], 1.0)
                if not rlist:
                    continue
                try:
                    chunk = os.read(master_fd, 2048)
                except OSError:
                    break
                if not chunk:
                    break
                sink.write(chunk)
                sink.flush()
                if not answered_pw and b"assword:" in chunk:
                    try:
                        os.write(master_fd, b"\n")
                        answered_pw = True
                    except OSError:
                        pass
        finally:
            try:
                os.close(master_fd)
            except OSError:
                pass
            if proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except OSError:
                    proc.terminate()
    os._exit(0)


def _kill_daemon(pid_path: str, out_path: str) -> None:
    pid = _read_int(pid_path)
    if pid > 1:
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for p in (pid_path, out_path):
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass


def start_ssh(instance_id: str) -> None:
    if not VALID_ID.fullmatch(instance_id) or os.environ.get("NOIR_VPS_ID") != instance_id:
        raise SystemExit(1)
    _ensure_sshd()
    pid = _read_int(PID_FILE)
    if pid > 1 and _alive(pid) and os.path.exists(OUT_FILE):
        raw = ANSI_RE.sub("", open(OUT_FILE, errors="replace").read(16384))
        if TCP_URL_RE.search(raw):
            return
    _kill_daemon(PID_FILE, OUT_FILE)
    _spawn_pinggy_pty("-R0:127.0.0.1:22", "tcp@free.pinggy.io", OUT_FILE, PID_FILE)


def read_ssh_info() -> None:
    if not os.path.exists(OUT_FILE) or not os.path.exists(PASS_FILE):
        raise SystemExit(1)
    raw = ANSI_RE.sub("", open(OUT_FILE, errors="replace").read(32768))
    match = TCP_URL_RE.search(raw)
    if not match:
        pid = _read_int(PID_FILE)
        if pid > 1 and not _alive(pid):
            tail = " ".join(raw.split())[-200:]
            sys.stderr.write(f"EXIT:{tail}\n")
            raise SystemExit(2)
        raise SystemExit(1)
    host, port = match.group(1), match.group(2)
    password = open(PASS_FILE).read().strip()
    sys.stdout.write(f"{host}\n{port}\n{password}\n")


def start_http(instance_id: str, port_raw: str) -> None:
    if not VALID_ID.fullmatch(instance_id) or os.environ.get("NOIR_VPS_ID") != instance_id:
        raise SystemExit(1)
    port = int(port_raw)
    if not 1 <= port <= 65535:
        raise SystemExit(1)
    pid_path = f"{HTTP_PID_PREFIX}{port}.pid"
    out_path = f"{HTTP_OUT_PREFIX}{port}.out"
    pid = _read_int(pid_path)
    if pid > 1 and _alive(pid) and os.path.exists(out_path):
        raw = ANSI_RE.sub("", open(out_path, errors="replace").read(16384))
        if HTTPS_URL_RE.search(raw):
            return
    _kill_daemon(pid_path, out_path)
    _spawn_pinggy_pty(f"-R0:127.0.0.1:{port}", "free.pinggy.io", out_path, pid_path)


def read_http_url(port_raw: str) -> None:
    port = int(port_raw)
    out_path = f"{HTTP_OUT_PREFIX}{port}.out"
    pid_path = f"{HTTP_PID_PREFIX}{port}.pid"
    if not os.path.exists(out_path):
        raise SystemExit(1)
    raw = ANSI_RE.sub("", open(out_path, errors="replace").read(32768))
    match = HTTPS_URL_RE.search(raw)
    if not match:
        pid = _read_int(pid_path)
        if pid > 1 and not _alive(pid):
            tail = " ".join(raw.split())[-200:]
            sys.stderr.write(f"EXIT:{tail}\n")
            raise SystemExit(2)
        raise SystemExit(1)
    sys.stdout.write(match.group(0))


def main() -> None:
    os.umask(0o077)
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    with open(DIR + "/lock", "a", opener=lambda p, f: os.open(p, f, 0o600)) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        action = sys.argv[1] if len(sys.argv) > 1 else ""
        if action == "start" and len(sys.argv) == 3:
            start_ssh(sys.argv[2])
        elif action == "info":
            read_ssh_info()
        elif action == "stop":
            _kill_daemon(PID_FILE, OUT_FILE)
        elif action == "http-start" and len(sys.argv) == 4:
            start_http(sys.argv[2], sys.argv[3])
        elif action == "http-url" and len(sys.argv) == 3:
            read_http_url(sys.argv[2])
        elif action == "http-stop" and len(sys.argv) == 3:
            port = int(sys.argv[2])
            _kill_daemon(f"{HTTP_PID_PREFIX}{port}.pid", f"{HTTP_OUT_PREFIX}{port}.out")
        else:
            raise SystemExit(2)


if __name__ == "__main__":
    main()
