#!/usr/bin/python3
"""Start OpenSSH sshd + a Pinggy TCP/HTTP tunnel inside the VPS container."""
import fcntl
import json
import os
import pty
import re
import secrets
import select
import signal
import socket
import string
import struct
import subprocess
import sys
import termios
import time
import urllib.request

DIR = "/tmp/noir-pinggy"
PID_FILE = DIR + "/pinggy.pid"
OUT_FILE = DIR + "/pinggy.out"
DBG_FILE = DIR + "/pinggy.dbg"
PASS_FILE = DIR + "/root.pass"
KEY_FILE = DIR + "/tunnel_key"
HTTP_PID_PREFIX = DIR + "/http-"
HTTP_OUT_PREFIX = DIR + "/http-"
HTTP_DBG_PREFIX = DIR + "/http-"

VALID_ID = re.compile(r"(?:noir|fier)-[a-f0-9]{12}\Z")
# Match current and legacy Pinggy domains (including *.run.pinggy-free.link,
# *.free.pinggy.net, *.a.free.pinggy.link, *.a.free.pinggy.online, *.pinggy.io)
TCP_URL_RE = re.compile(r"tcp://([A-Za-z0-9.-]*pinggy[A-Za-z0-9.-]*):([0-9]{2,5})")
HTTPS_URL_RE = re.compile(r"https://[A-Za-z0-9.-]*pinggy[A-Za-z0-9.-]*")
ANSI_RE = re.compile(r"\x1b(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~]|\][^\x07\x1b]*(?:\x07|\x1b\\))")


def _strip_ansi(text: str) -> str:
    return ANSI_RE.sub("", text).replace("\x00", "")


def _alive(pid: int) -> bool:
    if pid <= 1:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:
        with open(f"/proc/{pid}/stat", encoding="utf-8", errors="replace") as handle:
            stat_txt = handle.read()
        rparen = stat_txt.rfind(")")
        if rparen != -1 and stat_txt[rparen + 2 : rparen + 3] == "Z":
            return False
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            cmd = handle.read(4096)
        return b"noir-pinggy" in cmd or b"python" in cmd or b"ssh" in cmd
    except OSError:
        return False


def _read_int(path: str) -> int:
    try:
        with open(path) as handle:
            return int(handle.read().strip())
    except (OSError, ValueError):
        return 0


def _pick_free_port() -> int:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        return int(sock.getsockname()[1])


def _port_listening(port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.5):
            return True
    except OSError:
        return False


def _query_debugger_urls(dbg_port: int) -> list[str]:
    if dbg_port <= 0:
        return []
    try:
        with urllib.request.urlopen(
            f"http://127.0.0.1:{dbg_port}/urls", timeout=0.8
        ) as resp:
            payload = json.loads(resp.read(8192).decode("utf-8", "replace"))
        urls = payload.get("urls")
        if isinstance(urls, list):
            return [str(u).strip() for u in urls if isinstance(u, str)]
    except Exception:
        pass
    return []


def _ensure_tunnel_key() -> str:
    """Generate a passphrase-less client SSH key so Pinggy never blocks on password auth."""
    if not os.path.exists(KEY_FILE):
        subprocess.run(
            ["ssh-keygen", "-t", "ed25519", "-N", "", "-f", KEY_FILE, "-q"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
    return KEY_FILE


def _ensure_openssh_server() -> None:
    """Auto-install openssh-server on older pre-upgrade containers if missing."""
    if os.path.exists("/usr/sbin/sshd"):
        return
    if os.path.exists("/usr/bin/apt-get"):
        env = {**os.environ, "DEBIAN_FRONTEND": "noninteractive"}
        subprocess.run(
            ["apt-get", "update", "-qq"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=90,
            check=False,
        )
        subprocess.run(
            [
                "apt-get",
                "install",
                "-y",
                "-qq",
                "--no-install-recommends",
                "openssh-server",
                "openssh-client",
            ],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=120,
            check=False,
        )
    elif os.path.exists("/sbin/apk"):
        subprocess.run(
            ["apk", "add", "--no-cache", "openssh-server", "openssh-client"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=90,
            check=False,
        )


def _ensure_sshd() -> str:
    _ensure_openssh_server()
    if not os.path.exists("/usr/sbin/sshd"):
        sys.stderr.write("openssh-server is not installed inside this VPS.\n")
        raise SystemExit(3)
    os.makedirs("/run/sshd", mode=0o755, exist_ok=True)
    os.makedirs("/var/run/sshd", mode=0o755, exist_ok=True)
    os.makedirs("/etc/ssh/sshd_config.d", mode=0o755, exist_ok=True)
    subprocess.run(
        ["ssh-keygen", "-A"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    password = ""
    if os.path.exists(PASS_FILE):
        try:
            password = open(PASS_FILE).read().strip()
        except OSError:
            password = ""
    if len(password) < 12:
        alphabet = string.ascii_letters + string.digits
        password = "".join(secrets.choice(alphabet) for _ in range(16))
        with open(PASS_FILE, "w", opener=lambda p, f: os.open(p, f, 0o600)) as handle:
            handle.write(password + "\n")
    # Ensure root account is unlocked and has the generated password set
    subprocess.run(["passwd", "-u", "root"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    chpasswd = subprocess.Popen(
        ["chpasswd"],
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    chpasswd.communicate(f"root:{password}\n".encode())

    # Guarantee PermitRootLogin yes + PasswordAuthentication yes
    conf_line = (
        "\n# NOIR managed root SSH\n"
        "PermitRootLogin yes\n"
        "PasswordAuthentication yes\n"
        "PubkeyAuthentication yes\n"
        "UsePAM no\n"
    )
    drop_in = "/etc/ssh/sshd_config.d/99-noir.conf"
    with open(drop_in, "w") as handle:
        handle.write(conf_line)
    main_cfg = "/etc/ssh/sshd_config"
    if os.path.exists(main_cfg):
        txt = open(main_cfg, errors="replace").read()
        if "99-noir.conf" not in txt and "sshd_config.d" not in txt:
            with open(main_cfg, "a") as handle:
                handle.write(conf_line)
    if not _port_listening(22):
        subprocess.Popen(
            [
                "/usr/sbin/sshd",
                "-o",
                "PermitRootLogin=yes",
                "-o",
                "PasswordAuthentication=yes",
                "-o",
                "PubkeyAuthentication=yes",
                "-o",
                "UsePAM=no",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        for _ in range(25):
            if _port_listening(22):
                break
            time.sleep(0.2)
    if not _port_listening(22):
        sys.stderr.write("sshd did not start listening on port 22.\n")
        raise SystemExit(4)
    return password


def _spawn_pinggy_tunnel(
    remote_spec: str, target_dest: str, out_path: str, pid_path: str, dbg_path: str
) -> None:
    key_path = _ensure_tunnel_key()
    dbg_port = _pick_free_port()
    for p in (out_path, pid_path, dbg_path):
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass
    with open(dbg_path, "w", opener=lambda p, f: os.open(p, f, 0o600)) as handle:
        handle.write(str(dbg_port))

    # Double-fork daemon + close inherited FDs (including lock FD & Docker exec pipes)
    pid = os.fork()
    if pid > 0:
        os.waitpid(pid, 0)
        return
    os.setsid()
    pid2 = os.fork()
    if pid2 > 0:
        with open(pid_path, "w", opener=lambda p, f: os.open(p, f, 0o600)) as handle:
            handle.write(str(pid2))
        os._exit(0)

    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        try:
            os.dup2(devnull, fd)
        except OSError:
            pass
    try:
        max_fd = os.sysconf("SC_OPEN_MAX")
    except (ValueError, OSError):
        max_fd = 1024
    os.closerange(3, min(max_fd, 4096))

    master_fd, slave_fd = pty.openpty()
    # Set a standard 40x160 terminal window size so Pinggy never wraps URLs or hangs on 0x0 PTY
    try:
        winsz = struct.pack("HHHH", 40, 160, 0, 0)
        fcntl.ioctl(slave_fd, termios.TIOCSWINSZ, winsz)
    except OSError:
        pass

    ssh_bin = "/usr/bin/ssh" if os.path.exists("/usr/bin/ssh") else "ssh"
    # Use -T (non-TUI plain text output) + -L 127.0.0.1:<dbg_port>:localhost:4300 (JSON /urls API)
    cmd = [
        ssh_bin,
        "-p",
        "443",
        "-T",
        "-i",
        key_path,
        "-o",
        "IdentitiesOnly=yes",
        "-o",
        "StrictHostKeyChecking=no",
        "-o",
        "UserKnownHostsFile=/dev/null",
        "-o",
        "ServerAliveInterval=30",
        "-o",
        "ServerAliveCountMax=3",
        "-o",
        "ConnectTimeout=15",
        "-o",
        "ExitOnForwardFailure=no",
        "-o",
        "LogLevel=ERROR",
        f"-L127.0.0.1:{dbg_port}:localhost:4300",
        remote_spec,
        target_dest,
    ]
    proc = subprocess.Popen(
        cmd,
        stdin=slave_fd,
        stdout=slave_fd,
        stderr=slave_fd,
        close_fds=True,
        start_new_session=True,
        env={**os.environ, "HOME": "/home/noir", "TERM": "dumb"},
    )
    os.close(slave_fd)
    answered_pw = False
    with open(out_path, "wb", opener=lambda p, f: os.open(p, f, 0o600)) as sink:
        try:
            while proc.poll() is None:
                rlist, _, _ = select.select([master_fd], [], [], 1.0)
                if not rlist:
                    continue
                try:
                    chunk = os.read(master_fd, 2048)
                except OSError:
                    break
                if not chunk:
                    break
                sink.write(chunk)
                sink.flush()
                # Answer cursor-position query (DSR \x1b[6n) if ever sent
                if b"\x1b[6n" in chunk:
                    try:
                        os.write(master_fd, b"\x1b[1;1R")
                    except OSError:
                        pass
                if not answered_pw and b"assword:" in chunk:
                    try:
                        os.write(master_fd, b"\n")
                        answered_pw = True
                    except OSError:
                        pass
        finally:
            # Drain any trailing output if ssh exited quickly
            while True:
                rlist, _, _ = select.select([master_fd], [], [], 0.05)
                if not rlist:
                    break
                try:
                    tail_chunk = os.read(master_fd, 2048)
                except OSError:
                    break
                if not tail_chunk:
                    break
                sink.write(tail_chunk)
                sink.flush()
            try:
                os.close(master_fd)
            except OSError:
                pass
            if proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except OSError:
                    proc.terminate()
    os._exit(0)


def _kill_daemon(pid_path: str, out_path: str, dbg_path: str = "") -> None:
    pid = _read_int(pid_path)
    if pid > 1:
        try:
            os.killpg(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    for p in (pid_path, out_path, dbg_path):
        if not p:
            continue
        try:
            os.unlink(p)
        except FileNotFoundError:
            pass


def _extract_tcp_endpoint(dbg_path: str, out_path: str) -> tuple[str, str] | None:
    for url in _query_debugger_urls(_read_int(dbg_path)):
        m = TCP_URL_RE.search(url)
        if m:
            return m.group(1), m.group(2)
    if os.path.exists(out_path):
        raw = _strip_ansi(open(out_path, errors="replace").read(32768))
        m = TCP_URL_RE.search(raw)
        if m:
            return m.group(1), m.group(2)
    return None


def _extract_https_url(dbg_path: str, out_path: str) -> str | None:
    for url in _query_debugger_urls(_read_int(dbg_path)):
        if url.startswith("https://"):
            return url
    if os.path.exists(out_path):
        raw = _strip_ansi(open(out_path, errors="replace").read(32768))
        m = HTTPS_URL_RE.search(raw)
        if m:
            return m.group(0)
    return None


def start_ssh(instance_id: str) -> None:
    if not VALID_ID.fullmatch(instance_id) or os.environ.get("NOIR_VPS_ID") != instance_id:
        raise SystemExit(1)
    _ensure_sshd()
    pid = _read_int(PID_FILE)
    if pid > 1 and _alive(pid) and _extract_tcp_endpoint(DBG_FILE, OUT_FILE):
        return
    _kill_daemon(PID_FILE, OUT_FILE, DBG_FILE)
    _spawn_pinggy_tunnel("-R0:127.0.0.1:22", "tcp@free.pinggy.io", OUT_FILE, PID_FILE, DBG_FILE)


def read_ssh_info() -> None:
    if not os.path.exists(PASS_FILE):
        raise SystemExit(1)
    endpoint = _extract_tcp_endpoint(DBG_FILE, OUT_FILE)
    if endpoint is None:
        raw = (
            _strip_ansi(open(OUT_FILE, errors="replace").read(32768))
            if os.path.exists(OUT_FILE)
            else ""
        )
        tail = " ".join(raw.split())[-200:]
        pid = _read_int(PID_FILE)
        if pid > 1 and not _alive(pid):
            sys.stderr.write(f"EXIT:{tail}\n")
            raise SystemExit(2)
        if tail:
            sys.stderr.write(f"WAIT:{tail}\n")
        raise SystemExit(1)
    host, port = endpoint
    password = open(PASS_FILE).read().strip()
    sys.stdout.write(f"{host}\n{port}\n{password}\n")


def start_http(instance_id: str, port_raw: str) -> None:
    if not VALID_ID.fullmatch(instance_id) or os.environ.get("NOIR_VPS_ID") != instance_id:
        raise SystemExit(1)
    port = int(port_raw)
    if not 1 <= port <= 65535:
        raise SystemExit(1)
    pid_path = f"{HTTP_PID_PREFIX}{port}.pid"
    out_path = f"{HTTP_OUT_PREFIX}{port}.out"
    dbg_path = f"{HTTP_DBG_PREFIX}{port}.dbg"
    pid = _read_int(pid_path)
    if pid > 1 and _alive(pid) and _extract_https_url(dbg_path, out_path):
        return
    _kill_daemon(pid_path, out_path, dbg_path)
    _spawn_pinggy_tunnel(f"-R0:127.0.0.1:{port}", "free.pinggy.io", out_path, pid_path, dbg_path)


def read_http_url(port_raw: str) -> None:
    port = int(port_raw)
    out_path = f"{HTTP_OUT_PREFIX}{port}.out"
    pid_path = f"{HTTP_PID_PREFIX}{port}.pid"
    dbg_path = f"{HTTP_DBG_PREFIX}{port}.dbg"
    url = _extract_https_url(dbg_path, out_path)
    if not url:
        raw = (
            _strip_ansi(open(out_path, errors="replace").read(32768))
            if os.path.exists(out_path)
            else ""
        )
        tail = " ".join(raw.split())[-200:]
        pid = _read_int(pid_path)
        if pid > 1 and not _alive(pid):
            sys.stderr.write(f"EXIT:{tail}\n")
            raise SystemExit(2)
        if tail:
            sys.stderr.write(f"WAIT:{tail}\n")
        raise SystemExit(1)
    sys.stdout.write(url)


def main() -> None:
    os.umask(0o077)
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    if action == "info":
        read_ssh_info()
        return
    if action == "http-url" and len(sys.argv) == 3:
        read_http_url(sys.argv[2])
        return
    with open(DIR + "/lock", "a", opener=lambda p, f: os.open(p, f, 0o600)) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == "start" and len(sys.argv) == 3:
            start_ssh(sys.argv[2])
        elif action == "stop":
            _kill_daemon(PID_FILE, OUT_FILE, DBG_FILE)
        elif action == "http-start" and len(sys.argv) == 4:
            start_http(sys.argv[2], sys.argv[3])
        elif action == "http-stop" and len(sys.argv) == 3:
            port = int(sys.argv[2])
            _kill_daemon(
                f"{HTTP_PID_PREFIX}{port}.pid",
                f"{HTTP_OUT_PREFIX}{port}.out",
                f"{HTTP_DBG_PREFIX}{port}.dbg",
            )
        else:
            raise SystemExit(2)


if __name__ == "__main__":
    main()
